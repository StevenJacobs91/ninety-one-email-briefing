{
  "name": "ni-email-briefing-form",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "catalogue": "tsx scripts/build-module-catalogue.ts",
    "predev": "npm run catalogue",
    "prebuild": "npm run catalogue",
    "prebuild:prod": "npm run catalogue",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:prod": "vite build --mode prod",
    "fonts:fetch": "node scripts/fetch-fonts.cjs",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:features": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.101.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "uuid": "^11.0.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "linkedom": "^0.18.13",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
